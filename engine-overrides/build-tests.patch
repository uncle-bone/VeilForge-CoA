+void CheckVeilForgePresets()
+{
+    Config original;
+    original.enable = false;
+    original.debugView = 4;
+    original.logLevel = 2;
+    original.overlayKey.virtualKey = 0x75;
+    original.dryZones.count = 1;
+    original.dryZones.ids[0] = 1234;
+    original.zoneDensity.otherZones = 2.75f;
+
+    for (int level = 1; level <= 10; ++level)
+    {
+        Config applied = original;
+        Check(veilforge::ApplyPreset(applied, level), "VeilForge preset changes managed settings");
+        Check(veilforge::MatchingPreset(applied) == level, "VeilForge preset is recognized after applying");
+        Check(!applied.enable && applied.debugView == original.debugView && applied.logLevel == original.logLevel &&
+                  applied.overlayKey.virtualKey == original.overlayKey.virtualKey &&
+                  applied.dryZones.count == original.dryZones.count && applied.dryZones.ids[0] == original.dryZones.ids[0] &&
+                  applied.zoneDensity.otherZones == original.zoneDensity.otherZones,
+              "VeilForge preset preserves unrelated settings and zone data");
+
+        const int density = FindLiveSetting("Density");
+        SetLiveSettingValue(applied, density, LiveSettingValue(applied, density) + 0.01f);
+        Check(veilforge::MatchingPreset(applied) == 0, "VeilForge manual edits are identified as Custom");
+    }
+
+    Config unchanged = original;
+    Check(!veilforge::ApplyPreset(unchanged, 0) && !veilforge::ApplyPreset(unchanged, 11),
+          "VeilForge rejects invalid preset levels");
+}
+
